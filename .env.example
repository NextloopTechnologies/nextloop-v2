# Copy to .env.local and fill in. Placeholders only — never commit real values.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# readable by every visitor. A credential must never carry that prefix.

# --- Database -----------------------------------------------------------
# Payload's tables live in the `payload` schema; the app's existing tables
# stay in `public`. Declare this ONCE — a duplicated key silently keeps the
# last occurrence, and .env.local has historically carried four of them.
DATABASE_URI=postgres://user:password@host:5432/database

# --- Payload ------------------------------------------------------------
# Signs admin sessions AND draft-preview tokens. Changing it logs every admin
# out and invalidates outstanding preview links. Declare it once.
PAYLOAD_SECRET=generate-a-long-random-string

# --- Email (Resend) -----------------------------------------------------
# Without these, production refuses to send rather than pretending to: see
# src/lib/payload/email.ts. Password resets and admin invites need them.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=NextLoop Technologies

# Comma-separated. Who gets told when a lead arrives. Leave empty to turn
# notifications off — that is a valid choice, not an error.
LEAD_NOTIFICATION_TO=

# Redirects EVERY recipient to one inbox. Set this on staging so a deploy
# pointed at production data cannot mail real candidates while you click around.
EMAIL_OVERRIDE_RECIPIENT=

# --- Content source -----------------------------------------------------
# `payload` or `supabase` (default). See docs/CONTENT-SOURCE.md.
CONTENT_SOURCE=supabase

# --- ImageKit (server-only — never NEXT_PUBLIC_) ------------------------
IK_URL_ENDPOINT=https://ik.imagekit.io/yourid
IK_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
IK_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxx

# --- reCAPTCHA ----------------------------------------------------------
# The secret must differ from the site key. When they match, the form handler
# treats verification as unconfigured, skips it, and logs an error every time.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Site ---------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonicals, sitemaps and the
# admin deep-link in notification emails.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# --- Supabase (until the cutover) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SERVICE_ROLE_KEY=

# --- Legacy -------------------------------------------------------------
# Resume uploads still POST to ${NEXT_PUBLIC_API_ENDPOINT}/upload rather than
# through Payload's resumes collection.
NEXT_PUBLIC_API_ENDPOINT=
