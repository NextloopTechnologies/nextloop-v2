# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
# Production snapshots for seeding a test Payload instance. Contains real
# lead PII when exported with --with-pii. Never commit.
.seed-data/
# Transfer staging for files synced from a Claude session. Never source.
Claude outputs/

# Migration checkpoint. Ids only, no PII — but it is machine state,
# not source, and committing it would make a resumed run skip rows
# on someone else's machine.
.migrate-state.json
